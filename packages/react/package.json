{
  "name": "@cp949/scrolla-react",
  "version": "1.0.0",
  "description": "native scrolling을 유지하는 React 18/19용 custom scrollbar component",
  "keywords": [
    "react",
    "scrollbar",
    "custom-scrollbar",
    "native-scroll",
    "rtl"
  ],
  "license": "MIT",
  "author": "cp949",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/scrolla.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/cp949/scrolla#readme",
  "bugs": {
    "url": "https://github.com/cp949/scrolla/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "audit": "node scripts/audit-package.mjs",
    "audit-consumers": "node scripts/audit-consumers.mjs",
    "build": "node scripts/build.mjs",
    "check-types": "node scripts/audit-config-coverage.mjs && tsc --noEmit --project tsconfig.json && tsc --noEmit --project test/fixtures/react18-types/tsconfig.json && tsc --noEmit --project test/fixtures/slot-aria-types/tsconfig.json && tsc --noEmit --project test/browser-fixtures/controller-harness/tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json --ignore-pattern test/config-coverage.test.mts --ignore-pattern test/config-coverage.test.cts",
    "prepublishOnly": "node ../../scripts/publish-npm.mjs --lifecycle-guard",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "autoprefixer": "10.6.2",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.108.2",
    "types-react-18": "npm:@types/react@18.3.31",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
