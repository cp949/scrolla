{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CHROME83_WEBSERVER", "CHROME_LATEST_WEBSERVER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "@cp949/scrolla-react#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "scrolla-playground#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "audit": {
      "dependsOn": ["build"]
    },
    "audit-consumers": {
      "dependsOn": ["build"]
    },
    "check-types": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {}
  }
}
